<section class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">提案結果</h2>
    <div class="flex items-center gap-2">
      <button type="button"
              class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              data-action="rephrase#copyAllResults">
        結果をまとめてコピー
      </button>
      <button type="button"
              class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              data-action="rephrase#clearContent">
        入力をクリア
      </button>
    </div>
  </div>

  <div class="grid gap-4">
    <% if rephrased_results.present? %>
      <% rephrased_results.each do |result| %>
        <%= render partial: "phrases/phrase_card", locals: { result: result } %>
      <% end %>
    <% else %>
      <%= render partial: "phrases/phrase_card", locals: { result: { content: "ここに言い換え結果が表示されます。DB接続後は保存済みデータが表示されます。" } } %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white/70 p-4 text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
        まだ保存済みの結果がないため、サンプルカードを表示しています。
      </div>
    <% end %>
  </div>
</section>
